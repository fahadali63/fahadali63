{
  "name": "blueprints-ai-desktop",
  "version": "1.0.0",
  "description": "Desktop app that generates coordinated construction document sets from sketches, photos and plain-language descriptions.",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/engine.test.mjs",
    "test:e2e": "xvfb-run -a electron --no-sandbox --disable-gpu test/e2e/main.cjs",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "dist:mac": "electron-builder --mac"
  },
  "author": "fahadali63",
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.fahadali63.blueprintsai",
    "productName": "Blueprints AI Desktop",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "Blueprints-AI-Desktop-Setup-${version}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icon.png",
      "category": "Office",
      "maintainer": "fahadali63 <fahad@innotec-es.com>"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg"
      ],
      "icon": "build/icon.png"
    },
    "publish": null
  },
  "homepage": "https://github.com/fahadali63/fahadali63/tree/ccr-dd8046aa-vcgelo/blueprints-ai-desktop"
}